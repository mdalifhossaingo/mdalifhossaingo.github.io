<style>
:root{--bg:#080d14;--card:#101a28;--card2:#0d1622;--line:#253346;--white:#f3f7fb;--muted:#9aabbd;--green:#34d399;--blue:#38bdf8;--purple:#818cf8}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 48% -20%,#173b34 0,transparent 45%),var(--bg);color:var(--white);font:15px/1.65 Inter,system-ui,sans-serif;min-height:100vh}button,a,input,select,textarea{font:inherit}a{color:inherit;text-decoration:none}button{cursor:pointer}.wrap{width:min(1160px,calc(100% - 40px));margin:auto}.header{position:sticky;top:0;z-index:20;background:#080d14ef;backdrop-filter:blur(16px);border-bottom:1px solid #ffffff12}.nav{height:76px;display:flex;align-items:center;justify-content:space-between;gap:14px}.brand{display:flex;align-items:center;gap:10px;min-width:220px}.brand-pic{width:42px;height:42px;padding:2px;border-radius:50%;background:linear-gradient(130deg,var(--green),var(--blue),var(--purple));box-shadow:0 0 20px #10b98140}.brand-pic img{width:100%;height:100%;object-fit:cover;object-position:50% 22%;border-radius:50%;background:#101a28}.brand-name{font-weight:750;font-size:13px;line-height:1.2}.brand-name small{display:block;color:var(--green);font-size:10px;font-weight:500;margin-top:4px}.tabs{display:flex;align-items:center;gap:3px;padding:5px;border:1px solid #ffffff12;border-radius:999px;background:#101a28}.tabs a{text-decoration:none;color:#bcc9d6;border-radius:999px;padding:9px 11px;font-size:11px;font-weight:650;white-space:nowrap}.tabs a:hover,.tabs a.active{color:var(--green);background:#34d39917}.cta{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:999px;padding:12px 16px;color:#071a15;background:linear-gradient(100deg,var(--green),var(--blue));font-size:12px;font-weight:800;box-shadow:0 8px 28px #10b98130;white-space:nowrap}.cta:hover{filter:brightness(1.1);transform:translateY(-1px)}.menu{display:none;background:var(--card);border:1px solid var(--line);color:white;border-radius:10px;padding:8px 11px;font-size:19px}.page{display:block;min-height:calc(100vh - 140px);padding:55px 0 76px}.home-grid{min-height:590px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:25px}.badge{display:inline-flex;align-items:center;gap:8px;border:1px solid #34d3993d;background:#34d39910;color:#8de6bd;border-radius:999px;padding:7px 11px;font-size:11px;font-weight:750;letter-spacing:1.15px;text-transform:uppercase}.dot{width:7px;height:7px;background:var(--green);border-radius:50%;box-shadow:0 0 0 4px #34d39920}.home h1{font-size:clamp(43px,5.8vw,70px);line-height:1.04;letter-spacing:-3.9px;margin:20px 0 12px}.grad{color:transparent;background:linear-gradient(90deg,var(--green),#a7f3d0,var(--blue));background-clip:text;-webkit-background-clip:text}.home h2{font-size:18px;margin:0 0 12px}.lead{max-width:590px;color:#aab8c7;font-size:15px;margin:0 0 24px}.actions{display:flex;flex-wrap:wrap;gap:10px}.ghost{border:1px solid #ffffff24;border-radius:999px;padding:11px 16px;background:#ffffff06;color:#e3ebf2;font-size:12px;font-weight:700}.proof{display:flex;gap:12px;flex-wrap:wrap;color:#91a2b5;font-size:12px;margin-top:24px}.proof span+span:before{content:'•';color:var(--green);padding-right:12px}.portrait-box{height:440px;display:grid;place-items:center;position:relative}.halo{position:absolute;width:365px;height:365px;border-radius:50%;background:radial-gradient(circle,#153e37,#102531 58%,#12162a 70%,transparent 71%);box-shadow:0 0 90px #10b9811d}.halo:after{content:'';position:absolute;inset:-20px;border:1px solid #34d39955;border-radius:50%;box-shadow:0 0 35px #10b98115}.portrait{z-index:1;width:330px;height:330px;object-fit:cover;object-position:center 19%;border-radius:50%;overflow:hidden;border:3px solid #34d3998c;box-shadow:0 0 34px #10b98124}.eyebrow{color:var(--green);font-size:11px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase}.home-seo{padding:58px 0 64px;border-top:1px solid #ffffff12}.home-seo .intro{max-width:760px;margin:0 auto 26px;text-align:center}.home-seo h2{font-size:clamp(25px,3.5vw,36px);letter-spacing:-1.1px;line-height:1.2;margin:8px 0 11px}.home-seo .intro p{color:var(--muted);font-size:14px;margin:0}.home-seo-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.home-seo-card{border:1px solid #ffffff14;border-radius:16px;background:linear-gradient(145deg,#111d2c,#0c1420);padding:20px}.home-seo-card h3{font-size:16px;margin:0 0 8px}.home-seo-card p{font-size:13px;color:#aab8c7;margin:0}.home-seo-card a{display:inline-block;color:var(--green);font-size:12px;font-weight:700;margin-top:11px}.service-cta{margin-top:18px}.footer{border-top:1px solid #ffffff12;padding:17px 0;color:#8294a7;font-size:12px}.foot{display:flex;justify-content:space-between;gap:10px}.foot a{color:var(--green)}.floating-audit{position:fixed;right:22px;bottom:22px;z-index:30;box-shadow:0 10px 35px #10b98155}
@media(max-width:1050px){.tabs a{padding:8px;font-size:10px}.brand{min-width:195px}.cta{font-size:11px;padding:11px}}
@media(max-width:820px){.wrap{width:min(100% - 32px,1160px)}.nav{height:68px}.menu{display:block}.cta.desktop{display:none}.tabs{display:none;position:absolute;top:68px;left:0;right:0;border-radius:0;border-width:0 0 1px;background:#0b121cef;padding:12px;flex-direction:column;align-items:stretch}.tabs.open{display:flex}.tabs a{text-align:left;padding:11px 13px;font-size:14px;border-radius:9px}.home-grid{grid-template-columns:1fr;text-align:center;gap:0;padding:22px 0}.lead{margin-left:auto;margin-right:auto}.actions,.proof{justify-content:center}.portrait-box{height:360px}.portrait{height:290px;width:290px}.halo{width:300px;height:300px}.floating-audit{right:13px;bottom:14px;padding:12px 15px}}
@media(max-width:560px){.home h1{font-size:44px;letter-spacing:-2.5px}.home h2{font-size:16px}.lead{font-size:14px}.page{padding:40px 0 58px}.portrait-box{height:320px}.portrait{height:250px;width:250px}.halo{width:260px;height:260px}.foot{flex-direction:column}.proof{font-size:11px;gap:8px}.proof span+span:before{padding-right:8px}.home-seo{padding:45px 0}.home-seo-grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<header class="header">
  <div class="wrap nav">
    <a class="brand" href="./" aria-label="Md. Alif Hossain home">
      <span class="brand-pic"><img src="images/alif-hossain-small.jpg" alt="Md. Alif Hossain" width="42" height="42"></span>
      <span class="brand-name">Md. Alif Hossain<small>Modern Search Engine Marketer</small></span>
    </a>
    <nav class="tabs" id="tabs" aria-label="Main navigation">
      <a href="./" data-page="index">Home</a>
      <a href="about.html" data-page="about">About</a>
      <a href="services.html" data-page="services">Services</a>
      <a href="niches.html" data-page="niches">Niches</a>
      <a href="markets.html" data-page="markets">Service Markets</a>
      <a href="contact.html" data-page="contact">Contact</a>
    </nav>
    <a class="cta desktop" href="contact.html?service=Free%20SEO%20Audit">⌕ &nbsp;Get Free Audit</a>
    <button class="menu" id="menu" aria-label="Open navigation" aria-expanded="false">☰</button>
  </div>
</header>

<main class="wrap">
  <section class="page home" id="page-home">
    <div class="home-grid">
      <div>
        <span class="badge"><i class="dot"></i> Local SEO · E-commerce SEO · Paid Search</span>
        <h1>Md. Alif Hossain<br><span class="grad">Search Marketing<br>for Growth</span></h1>
        <h2>Local SEO, E-commerce SEO &amp; Paid Search</h2>
        <p class="lead">I help local service businesses and online stores get found on Google, so more customers call, request quotes and place orders.</p>
        <div class="actions">
          <a class="cta" href="contact.html?service=Free%20SEO%20Audit">⌕ &nbsp;Get Free Audit</a>
          <a class="ghost" href="https://wa.me/8801308304946" target="_blank" rel="noopener">Connect via WhatsApp ↗</a>
        </div>
        <div class="proof"><span>Local service leads</span><span>More store discovery</span><span>Remote support in 11 markets</span></div>
      </div>
      <div class="portrait-box">
        <div class="halo"></div>
        <img class="portrait" src="images/alif-hossain.jpg" alt="Md. Alif Hossain, SEO expert and search engine marketer" width="500" height="500" fetchpriority="high" decoding="async">
      </div>
    </div>
  </section>

  <section class="home-seo">
    <div class="intro">
      <span class="eyebrow">Search growth services</span>
      <h2>SEO that helps customers find and choose your business.</h2>
      <p>Based in Bangladesh and working remotely, I support local service companies and online stores with SEO, technical improvements and paid search.</p>
    </div>
    <div class="home-seo-grid">
      <article class="home-seo-card">
        <h3>Local SEO for service businesses</h3>
        <p>Support for HVAC, plumbing, electricians, roofing, asphalt contractors, mold and water damage restoration, and garage door repair. Work may include Google Business Profile optimization, service-area page strategy, on-page and technical SEO, and reporting on calls and leads.</p>
        <a href="services.html">Explore local SEO services →</a>
      </article>
      <article class="home-seo-card">
        <h3>E-commerce SEO</h3>
        <p>SEO for Shopify, WordPress and Webflow stores, with attention to category and product pages, site structure, indexing, and content that helps shoppers make informed decisions.</p>
        <a href="niches.html">Explore specialist niches →</a>
      </article>
      <article class="home-seo-card">
        <h3>Search Engine Marketing &amp; Paid Ads</h3>
        <p>Google Ads planning and campaign structure, keyword and ad copy planning, landing page recommendations, conversion tracking setup, and ongoing campaign review.</p>
        <a href="services.html">See marketing services →</a>
      </article>
      <article class="home-seo-card">
        <h3>Free SEO audit</h3>
        <p>Request a technical check, on-page review, local SEO check where relevant, and clear next steps for improving your website’s search presence.</p>
        <a href="contact.html?service=Free%20SEO%20Audit">Request an audit →</a>
      </article>
    </div>
    <div class="service-cta" style="text-align:center"><a class="cta" href="contact.html?service=Free%20SEO%20Audit">Get Free Audit&nbsp; ↗</a></div>
  </section>
</main>

<footer class="footer">
  <div class="wrap foot">
    <span>© <span id="year"></span> Md. Alif Hossain · Search Engine Marketer</span>
    <span><a href="./">Home ↑</a></span>
  </div>
</footer>

<a class="cta floating-audit" href="contact.html?service=Free%20SEO%20Audit">⌕ &nbsp;Get Free Audit</a>

<script>
const menu=document.querySelector('.menu'),nav=document.querySelector('.tabs');
menu.addEventListener('click',()=>{const open=nav.classList.toggle('open');menu.setAttribute('aria-expanded',open);menu.textContent=open?'×':'☰'});
nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>nav.classList.remove('open')));
document.querySelector('#year').textContent=new Date().getFullYear();
const page=(location.pathname.split('/').pop().replace('.html',''))||'index';
document.querySelectorAll('[data-page]').forEach(a=>{if(a.dataset.page===page)a.classList.add('active')});
</script>
</body>
</html>
